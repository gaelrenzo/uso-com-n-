# ==============================================================================
# CONFIGURACION UCN - Mochila Digital
# ==============================================================================
# Sistema multi-plataforma: Termux/Android, Linux, Windows, macOS
# Los paths se resuelven segun la plataforma donde se ejecute.
# ==============================================================================

developer:
  name: "Tu Nombre"
  email: "tu@email.com"

# --- Paths segun plataforma ---
# Si no se especifica plataforma, se usan los defaults en paths.default
platforms:
  termux:
    data_dir: "/storage/emulated/0/universida-datos"
    workspace: "~/workspace"
  linux:
    data_dir: "~/universida-datos"
    workspace: "~/workspace"
  windows:
    data_dir: "%USERPROFILE%/universida-datos"
    workspace: "%USERPROFILE%/workspace"
  macos:
    data_dir: "~/universida-datos"
    workspace: "~/workspace"

# --- Paths por defecto (fallback si no hay plataforma especifica) ---
paths:
  default:
    data_dir: "~/universida-datos"
    notas: "~/universida-datos/notas"
    informes: "~/universida-datos/informes"
    cursos: "~/universida-datos/cursos"
    laboratorios: "~/universida-datos/laboratorios"
  # Override manual opcional
  termux:
    data_dir: "/storage/emulated/0/universida-datos"
  linux: {}
  windows:
    data_dir: "%USERPROFILE%/universida-datos"

# --- Agentes IA instalados ---
agents:
  claude:
    enabled: true
    path: "~/.claude"
  codex:
    enabled: true
    path: "~/.codex"
  antigravity:
    enabled: true
    path: "~/.antigravity"
  opencode:
    enabled: true
    path: "~/.config/opencode"
  cursor:
    enabled: true
    path: "~/.cursor"
  gemini:
    enabled: true
    path: "~/.gemini"

# --- Ajustes generales ---
settings:
  auto_pull_on_sync: true
  safe_push_ignore_removal: true
  weather_city: "Puno"