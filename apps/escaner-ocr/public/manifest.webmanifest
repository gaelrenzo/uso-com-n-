{
  "name": "Escáner OCR UCN",
  "short_name": "Escáner",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0d1117",
  "theme_color": "#1f6feb",
  "icons": [
    {
      "src": "icono-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icono.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "scope": "./",
  "id": "escaner-ocr-ucn",
  "share_target": {
    "action": "./?compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "imagenes",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}